<root>
  <scripts>
    <include src="file://{resources}/scripts/custom_game/challenge.js" />
  </scripts>

  <styles>
    <include src="file://{resources}/styles/custom_game/challenge.css" />
  </styles>

  <Panel class="--challenge hud-visible hide" hittest="false">
    <Panel class="combo" hittest="false">
      <Panel id="sequence" hittest="false" />
    </Panel>

    <Panel id="splash" hittest="false" hittestchildren="false">
      <DOTAScenePanel
        class="splash-fx"
        map="backgrounds/pregame_phase"
        camera="camera"
        renderdeferred="false"
        particleonly="true"
        hittest="false"
        require-composition-layer="true"
      />

      <Panel class="splash-box">
        <Label
          id="splash-title"
          class="splash-title"
          text="#invk_combo_splash__start__title__1"
        />

        <Label
          id="splash-help"
          class="splash-help"
          text="#invk_combo_splash__start__help__1"
        />
      </Panel>
    </Panel>

    <Panel id="wait-progress" class="hide">
      <CircularProgressBar id="wait-progressbar" />
      <Panel class="wait-progressbar-overlay" />
      <Label class="wait-progress-text" text="{d:wait_seconds}" />
    </Panel>

    <Panel id="score" />

    <Panel class="controls" hittest="false">
      <Panel class="control-icon">
        <Button
          id="btn-show-details"
          class="icon-button icon-details grey"
          onmouseover="UIShowTextTooltip(#invk_combo_tooltip_details)"
          onmouseout="UIHideTextTooltip()"
        />
      </Panel>

      <Panel class="control-icon">
        <Button
          id="btn-cycle-hud"
          class="icon-button icon-cycle-hud grey"
          onmouseover="UIShowTextTooltip(#invk_combo_tooltip_hud)"
          onmouseout="UIHideTextTooltip()"
        />
      </Panel>

      <Panel class="control-icon">
        <Button
          id="btn-restart"
          class="icon-button icon-restart blue"
          onmouseover="UIShowTextTooltip(#invk_controls_restart)"
          onmouseout="UIHideTextTooltip()"
        />
      </Panel>

      <Panel class="control-icon">
        <Button
          id="btn-full-restart"
          class="icon-button icon-full-restart bronze"
          onmouseover="UIShowTextTooltip(#invk_controls_full_restart)"
          onmouseout="UIHideTextTooltip()"
        />
      </Panel>

      <Panel class="control-icon">
        <Button
          id="btn-stop"
          class="icon-button icon-stop red"
          onmouseover="UIShowTextTooltip(#invk_controls_stop)"
          onmouseout="UIHideTextTooltip()"
        />
      </Panel>
    </Panel>

    <Panel id="timer" class="hide">
      <Panel class="timer-bg" />
      <Label id="timer-label" hittest="false" />
    </Panel>
  </Panel>
</root>
