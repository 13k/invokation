<root>
  <scripts>
    <include src="file://{resources}/scripts/custom_game/combat_log.js" />
  </scripts>

  <styles>
    <include src="file://{resources}/styles/custom_game/combat_log.css" />
  </styles>

  <Panel class="root closed" hittest="false">
    <Panel class="combat-log">
      <Panel id="contents" />

      <Panel class="bar">
        <ToggleButton id="btn-toggle" class="thumb">
          <Label class="title" text="#invk_combat_log_title" hittest="false" />
        </ToggleButton>

        <Panel class="bar-actions">
          <ToggleButton
            id="filter-invocations"
            class="bar-item"
            text="#invk_combat_log_filter_invocations"
            selected="true"
          />

          <Button id="btn-clear" class="bar-item">
            <Label class="btn-text" text="#invk_combat_log_clear" hittest="false" />
          </Button>
        </Panel>
      </Panel>
    </Panel>
  </Panel>
</root>
