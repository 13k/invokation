<!-- Combo Score (shamelessly rippped from ES arcana) -->
<root>
  <scripts>
    <include src="file://{resources}/scripts/custom_game/combo_score.js" />
  </scripts>

  <styles>
    <include src="file://{resources}/styles/custom_game/combo_score.css" />
  </styles>

  <Panel class="--combo-score" hittest="false" hittestchildren="false">
    <Panel id="counter">
      <Panel class="splash-background">
        <DOTAScenePanel
          id="counter-fx"
          camera="camera"
          renderdeferred="false"
          rendershadows="false"
          particleonly="true"
          map="scenes/hud/ui_es_arcana_combo_ambient"
          require-composition-layer="true"
        />
      </Panel>

      <Panel class="content">
        <Panel id="counter-ticker" class="digit-container">
          <Panel class="digit-x" />
          <Panel class="digit" />
          <Panel class="digit" />
          <Panel class="digit" />
        </Panel>

        <Label class="label" text="#invk_combo_counter_title" />
      </Panel>
    </Panel>

    <Panel id="summary">
      <Panel class="splash-background">
        <DOTAScenePanel
          id="summary-fx"
          camera="camera"
          renderdeferred="false"
          rendershadows="false"
          particleonly="true"
          map="scenes/hud/ui_es_arcana_combo_summary"
          require-composition-layer="true"
        />
      </Panel>

      <Panel class="content">
        <Panel class="count">
          <Panel id="summary-count-display" class="digit-container">
            <Panel class="digit-x" />
            <Panel class="digit" />
            <Panel class="digit" />
            <Panel class="digit" />
          </Panel>

          <Label class="label" text="#invk_combo_counter_title" />
        </Panel>

        <Panel class="damage">
          <Panel id="summary-damage-ticker" class="digit-container">
            <Panel class="digit" />
            <Panel class="digit" />
            <Panel class="digit" />
            <Panel class="digit" />
            <Panel class="digit" />
          </Panel>

          <Label class="label" text="#invk_combo_counter_damage_label" />
        </Panel>
      </Panel>
    </Panel>
  </Panel>
</root>
