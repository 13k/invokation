<root>
  <scripts>
    <include src="file://{resources}/scripts/custom_game/picker.js" />
  </scripts>

  <styles>
    <include src="file://{resources}/styles/custom_game/picker.css" />
  </styles>

  <Panel class="root--picker" hittest="false">
    <Panel id="picker" class="drawer-closed filters-closed" hittest="false">
      <Panel class="contents" hittest="false">
        <Panel class="title-container">
          <Button id="btn-reload" class="hide" />
          <Label class="title" text="#invk_picker_title" hittest="false" />
        </Panel>

        <Panel class="header">
          <ToggleButton
            id="btn-toggle-filters"
            onmouseover="UIShowTextTooltip(#invk_picker_tooltip_filters_toggle)"
            onmouseout="UIHideTextTooltip()"
          />

          <Button id="btn-freestyle">
            <Label class="freestyle-label" text="#invk_picker_freestyle_play" hittest="false" />
          </Button>
        </Panel>

        <Panel class="body">
          <Panel id="combos" hittest="false" />

          <Panel id="filters" hittest="false">
            <Panel class="filters-row" hittest="false">
              <Panel class="flow-right">
                <Label class="filters-label" text="#invk_combo_properties__tags" hittest="false" />

                <Button
                  id="btn-filter-tags-reset"
                  class="filter-reset-button"
                  disabled="true"
                  onmouseover="UIShowTextTooltip(#invk_picker_tooltip_filter_tags_reset)"
                  onmouseout="UIHideTextTooltip()"
                />
              </Panel>

              <Panel id="filter-tags-container" />
            </Panel>

            <Panel class="filters-row" hittest="false">
              <Label
                class="filters-label"
                text="#invk_combo_properties__specialty"
                hittest="false"
              />

              <DropDown id="filter-specialty" />
            </Panel>

            <Panel class="filters-row" hittest="false">
              <Label
                class="filters-label"
                text="#invk_combo_properties__stance"
                hittest="false"
              />

              <DropDown id="filter-stance" />
            </Panel>

            <Panel class="filters-row" hittest="false">
              <Label
                class="filters-label"
                text="#invk_combo_properties__damage_rating"
                hittest="false"
              />

              <DropDown id="filter-damage-rating" />
            </Panel>

            <Panel class="filters-row" hittest="false">
              <Label
                class="filters-label"
                text="#invk_combo_properties__difficulty_rating"
                hittest="false"
              />

              <DropDown id="filter-difficulty-rating" />
            </Panel>

            <Panel class="filters-row popup-row" hittest="false">
              <Panel class="popup-column">
                <Panel class="flow-right">
                  <Label class="popup-label" text="#invk_picker_filter_item" hittest="false" />

                  <Button
                    id="btn-filter-item-reset"
                    class="filter-reset-button"
                    disabled="true"
                    onmouseover="UIShowTextTooltip(#invk_picker_tooltip_filter_item_reset)"
                    onmouseout="UIHideTextTooltip()"
                  />
                </Panel>

                <Button id="btn-filter-item" class="popup-button">
                  <DOTAItemImage id="filter-item-image" />
                </Button>
              </Panel>

              <Panel class="popup-column">
                <Panel class="flow-right">
                  <Label class="popup-label" text="#invk_picker_filter_ability" hittest="false" />

                  <Button
                    id="btn-filter-ability-reset"
                    class="filter-reset-button"
                    disabled="true"
                    onmouseover="UIShowTextTooltip(#invk_picker_tooltip_filter_ability_reset)"
                    onmouseout="UIHideTextTooltip()"
                  />
                </Panel>

                <Button id="btn-filter-ability" class="popup-button">
                  <DOTAAbilityImage id="filter-ability-image" />
                </Button>
              </Panel>
            </Panel>

            <Panel class="filters-row buttons-row" hittest="false">
              <Button id="btn-reset-filters" class="small">
                <Label text="#invk_picker_filters_reset" hittest="false" />
              </Button>
            </Panel>
          </Panel>
        </Panel>
      </Panel>

      <Button id="btn-toggle" class="thumb">
        <Panel class="thumb-arrow" />
      </Button>
    </Panel>
  </Panel>
</root>
