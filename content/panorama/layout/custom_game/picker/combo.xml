<root>
  <scripts>
    <include src="file://{resources}/scripts/custom_game/picker/combo.js" />
  </scripts>

  <styles>
    <include src="file://{resources}/styles/custom_game/picker/combo.css" />
  </styles>

  <Panel class="--picker--combo">
    <Panel class="title-container">
      <Button
        id="finished-icon"
        onmouseover="UIShowTextTooltip(#invk_combo_tooltip_finished)"
        onmouseout="UIHideTextTooltip()"
      />

      <Label id="title" class="title" hittest="false" />
    </Panel>

    <Panel id="info-container">
      <Button
        class="icon hero-level-icon"
        onmouseover="UIShowTextTooltip(#invk_combo_tooltip_hero_level)"
        onmouseout="UIHideTextTooltip()"
      >
        <Label id="hero-level-label" hittest="false" />
      </Button>

      <Button
        id="btn-details"
        class="icon info-icon"
        onmouseover="UIShowTextTooltip(#invk_combo_tooltip_details)"
        onmouseout="UIHideTextTooltip()"
      />

      <Button
        class="icon specialty-icon"
        onmouseover="UIShowTextTooltip(#invk_combo_tooltip_specialty)"
        onmouseout="UIHideTextTooltip()"
      />

      <Button
        class="icon stance-icon"
        onmouseover="UIShowTextTooltip(#invk_combo_tooltip_stance)"
        onmouseout="UIHideTextTooltip()"
      />

      <Panel class="ratings">
        <Panel class="flow-right">
          <Button
            class="attack-damage-icon"
            onmouseover="UIShowTextTooltip(#invk_combo_tooltip_damage_rating)"
            onmouseout="UIHideTextTooltip()"
          />

          <Panel id="damage-rating" class="rating">
            <Panel class="rating-active" />
          </Panel>
        </Panel>

        <Panel class="flow-right">
          <Button
            class="difficulty-icon"
            onmouseover="UIShowTextTooltip(#invk_combo_tooltip_difficulty_rating)"
            onmouseout="UIHideTextTooltip()"
          />

          <Panel id="difficulty-rating" class="rating">
            <Panel class="rating-active" />
          </Panel>
        </Panel>
      </Panel>
    </Panel>

    <Button id="btn-play">
      <Label class="btn-label" text="#invk_controls_play" hittest="false" />
    </Button>
  </Panel>
</root>
