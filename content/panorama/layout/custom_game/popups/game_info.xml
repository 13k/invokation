<root>
  <scripts>
    <include src="file://{resources}/scripts/custom_game/popups/game_info.js" />
  </scripts>

  <styles>
    <include src="file://{resources}/styles/custom_game/popups/game_info.css" />
  </styles>

  <Popup class="--popups--game-info Hidden" popupbackground="dim">
    <Button id="btn-close" class="popup-close-btn dark-grey">
      <Image src="s2r://panorama/images/control_icons/24px/x_close.vsvg" class="btn-image" />
    </Button>

    <Panel class="contents">
      <Label class="popup-title" text="#invk_game_info_title" hittest="false" />

      <DOTAScenePanel
        class="orbs-scene"
        map="custom_game/scenes/kid_invoker_orbs"
        camera="camera"
        particleonly="false"
        hittest="false"
      />

      <Label
        class="popup-description"
        text="#invk_game_info_description"
        html="true"
        hittest="false"
      />

      <Panel class="separator" />

      <Panel class="popup-btn-row">
        <Panel class="meta-item">
          <Label id="version-label" class="meta-text" />
        </Panel>

        <Button id="btn-open-homepage" class="meta-item btn-link">
          <Label class="meta-text link-text" text="#invk_game_info_home_page" />
          <Panel class="arrow-icon" />
        </Button>

        <Button id="btn-open-changelog" class="meta-item btn-link">
          <Label class="meta-text link-text" text="#invk_game_info_changelog" />
          <Panel class="arrow-icon" />
        </Button>
      </Panel>
    </Panel>
  </Popup>
</root>
