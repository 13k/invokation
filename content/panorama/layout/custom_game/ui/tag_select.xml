<root>
  <scripts>
    <include src="file://{resources}/scripts/custom_game/ui/tag_select.js" />
  </scripts>

  <styles>
    <include src="file://{resources}/styles/custom_game/ui/tag_select.css" />
  </styles>

  <snippets>
    <snippet name="tag">
      <Panel class="tag" hittest="false">
        <Label class="tag-label" text="{s:value}" hittest="false" />
        <Button id="tag-remove-button" class="tag-remove-button" />
      </Panel>
    </snippet>
  </snippets>

  <Panel class="root--ui--tag-select" hittest="false">
    <DropDown id="options" />
    <Panel id="tag-list" hittest="false" />
  </Panel>
</root>
