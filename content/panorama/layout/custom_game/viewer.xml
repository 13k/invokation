<root>
  <scripts>
    <include src="file://{resources}/scripts/custom_game/viewer.js" />
  </scripts>

  <styles>
    <include src="file://{resources}/styles/custom_game/viewer.css" />
  </styles>

  <Panel class="--viewer closed" hittest="false">
    <Panel id="viewer" hittest="false">
      <Button id="btn-close" />
      <Button id="btn-reload" />

      <Panel id="information-background" hittest="false" />

      <Panel id="information-body" hittest="false">
        <Label id="title" html="true" hittest="false" />

        <Panel id="scroll-panel" class="flow-down">
          <Panel id="properties-section" class="section" hittest="false" />

          <Label id="description" html="true" hittest="false" />

          <Panel class="section abilities-build-section" hittest="false">
            <Panel class="section-header" hittest="false">
              <Label
                class="section-label"
                text="#invk_viewer_abilities_build_title"
                hittest="false"
              />
            </Panel>

            <Panel id="abilities-build" hittest="false">
              <Panel id="talents" class="orb" />
              <!-- <DOTAUITalentDisplay id="talents" /> -->

              <Panel class="orb" hittest="false">
                <DOTAAbilityImage
                  id="orb-quas"
                  abilityname="invoker_quas"
                  onmouseout="DOTAHideAbilityTooltip()"
                />

                <Label id="orb-quas-label" class="orb-label" hittest="false" />
              </Panel>

              <Panel class="orb" hittest="false">
                <DOTAAbilityImage
                  id="orb-wex"
                  abilityname="invoker_wex"
                  onmouseout="DOTAHideAbilityTooltip()"
                />

                <Label id="orb-wex-label" class="orb-label" hittest="false" />
              </Panel>

              <Panel class="orb" hittest="false">
                <DOTAAbilityImage
                  id="orb-exort"
                  abilityname="invoker_exort"
                  onmouseout="DOTAHideAbilityTooltip()"
                />

                <Label id="orb-exort-label" class="orb-label" hittest="false" />
              </Panel>
            </Panel>
          </Panel>

          <Panel class="section sequence-section" hittest="false">
            <Panel class="section-header" hittest="false">
              <Label
                class="section-label"
                text="#invk_viewer_sequence_title"
                hittest="false"
              />
            </Panel>

            <Label
              class="section-label"
              text="#invk_viewer_sequence_disclaimer"
              hittest="false"
            />

            <Panel id="sequence" hittest="false" />
          </Panel>
        </Panel>
      </Panel>

      <Panel id="footer" hittest="false">
        <Panel class="buttons" hittest="false">
          <Button id="btn-play">
            <Label class="play-label" text="#invk_controls_play" hittest="false" />
          </Button>
        </Panel>
      </Panel>
    </Panel>
  </Panel>
</root>
