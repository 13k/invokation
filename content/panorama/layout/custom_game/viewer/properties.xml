<root>
  <scripts>
    <include src="file://{resources}/scripts/custom_game/viewer/properties.js" />
  </scripts>

  <styles>
    <include src="file://{resources}/styles/custom_game/viewer/properties.css" />
  </styles>

  <Panel class="root" hittest="false">
    <Panel class="row" hittest="false">
      <Button
        class="icon hero-level-icon"
        onmouseover="DOTAShowTextTooltip(#invk_combo_tooltip_hero_level)"
        onmouseout="DOTAHideTextTooltip()"
      />

      <Label class="label" text="#invk_combo_properties__hero_level" hittest="false" />

      <Button class="value hero-level-badge">
        <Label id="hero-level-label" class="hero-level-label" hittest="false" />
      </Button>
    </Panel>

    <Panel class="row" hittest="false">
      <Button
        class="icon specialty-icon"
        onmouseover="DOTAShowTextTooltip(#invk_combo_tooltip_specialty)"
        onmouseout="DOTAHideTextTooltip()"
      />

      <Label class="label" text="#invk_combo_properties__specialty" hittest="false" />
      <Label id="specialty-label" class="value label" hittest="false" />
    </Panel>

    <Panel class="row" hittest="false">
      <Button
        class="icon stance-icon"
        onmouseover="DOTAShowTextTooltip(#invk_combo_tooltip_stance)"
        onmouseout="DOTAHideTextTooltip()"
      />

      <Label class="label" text="#invk_combo_properties__stance" hittest="false" />
      <Label id="stance-label" class="value label" hittest="false" />
    </Panel>

    <Panel class="row" hittest="false">
      <Button
        class="icon attack-damage-icon"
        onmouseover="DOTAShowTextTooltip(#invk_combo_tooltip_damage_rating)"
        onmouseout="DOTAHideTextTooltip()"
      />

      <Label class="label" text="#invk_combo_properties__damage_rating" hittest="false" />

      <Panel id="damage-rating" class="value rating">
        <Panel class="RatingActive" />
      </Panel>
    </Panel>

    <Panel class="row" hittest="false">
      <Button
        class="icon difficulty-icon"
        onmouseover="DOTAShowTextTooltip(#invk_combo_tooltip_difficulty_rating)"
        onmouseout="DOTAHideTextTooltip()"
      />

      <Label class="label" text="#invk_combo_properties__difficulty_rating" hittest="false" />

      <Panel id="difficulty-rating" class="value rating">
        <Panel class="rating-active" />
      </Panel>
    </Panel>
  </Panel>
</root>
